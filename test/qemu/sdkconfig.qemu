# Overrides for the QEMU test build (see test/qemu/README.md). Never flash this.
CONFIG_NTRIP_QEMU_TEST=y
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_OPENETH=y
CONFIG_ETH_OPENETH_DMA_RX_BUFFER_NUM=10
CONFIG_ETH_OPENETH_DMA_TX_BUFFER_NUM=4
# QEMU emulates a rev 0 chip
CONFIG_ESP32_REV_MIN_0=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
